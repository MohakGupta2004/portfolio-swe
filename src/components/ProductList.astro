---
// Product rows. Hover: other rows blur and a screenshot follows the cursor. Click: the row opens.
import type { Product } from '../data/work';

interface Props {
	products: Product[];
}

const { products } = Astro.props;
---

<div class="product-list relative">
	{
		products.map((product) => (
			<details class="product-row group border-b border-dotted border-foreground/40 last:border-b-0">
				<summary class="flex cursor-pointer list-none items-baseline justify-between gap-4 py-3 [&::-webkit-details-marker]:hidden">
					<span class="min-w-0">
						<span class="font-heading text-2xl group-hover:dotted">{product.name}</span>
						<span class="mt-0.5 block truncate text-sm text-foreground/60">{product.about}</span>
					</span>
					<span class="font-mono shrink-0 text-xs text-foreground/60">{product.domain}</span>
					{product.thumbnail && (
						<span class="product-follow pointer-events-none absolute left-0 top-0 z-10">
							<img
								src={product.thumbnail}
								alt=""
								loading="lazy"
								decoding="async"
								class="product-thumb aspect-video w-72 -translate-x-1/2 rounded-md border border-foreground/40 object-cover"
							/>
						</span>
					)}
				</summary>

				<div class="pb-5">
					{product.thumbnail && (
						<img
							src={product.thumbnail}
							alt={`${product.name} website`}
							loading="lazy"
							class="touch-image mb-4 aspect-video w-full rounded-md border border-foreground/40 object-cover"
						/>
					)}

					<ul class="space-y-2">
						{product.points.map((point) => (
							<li class="flex gap-3 text-sm leading-relaxed text-foreground/60">
								<span class="mt-1.5 size-2 shrink-0 bg-(--accent)" />
								{point}
							</li>
						))}
					</ul>

					<ul class="mt-4 flex flex-wrap gap-2">
						{product.roles.map((role) => (
							<li class="rounded bg-foreground/10 px-2 py-1 text-xs">{role}</li>
						))}
						{product.tech.map((name) => (
							<li class="rounded border border-foreground/30 px-2 py-1 text-xs text-foreground/60">{name}</li>
						))}
					</ul>

					<a href={product.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-sm hover:dotted">
						Visit {product.domain} ↗
					</a>
				</div>
			</details>
		))
	}
</div>

<script>
	// The screenshot glides toward the cursor. Position is saved on the list as --x and --y.
	function setupList(list: HTMLElement) {
		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let isRunning = false;

		function move() {
			currentX = currentX + (targetX - currentX) * 0.15;
			currentY = currentY + (targetY - currentY) * 0.15;
			list.style.setProperty('--x', currentX + 'px');
			list.style.setProperty('--y', currentY + 'px');

			const isFarAway = Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5;
			if (isFarAway) {
				requestAnimationFrame(move);
			} else {
				isRunning = false;
			}
		}

		list.addEventListener('mouseenter', (event) => {
			const box = list.getBoundingClientRect();
			currentX = event.clientX - box.left;
			currentY = event.clientY - box.top;
		});

		list.addEventListener('mousemove', (event) => {
			const box = list.getBoundingClientRect();
			const firstThumb = list.querySelector<HTMLElement>('.product-thumb');
			const thumbHeight = firstThumb ? firstThumb.offsetHeight : 162;
			const gap = 24;

			let offsetY = gap;
			if (event.clientY + gap + thumbHeight > window.innerHeight) {
				offsetY = -(gap + thumbHeight);
			}

			targetX = event.clientX - box.left;
			targetY = event.clientY - box.top + offsetY;
			if (!isRunning) {
				isRunning = true;
				requestAnimationFrame(move);
			}
		});
	}

	if (window.matchMedia('(hover: hover)').matches) {
		for (const list of document.querySelectorAll<HTMLElement>('.product-list')) {
			setupList(list);
		}
	}
</script>

<style>
	.product-follow {
		transform: translate3d(var(--x, 0), var(--y, 0), 0);
	}

	.product-thumb {
		opacity: 0;
		transform: scale(0.95);
		transition: opacity 150ms ease-out;
	}

	/* An open row already shows its own screenshot, so the floating one stays hidden. */
	.product-row[open] .product-follow {
		display: none;
	}

	@media (hover: none) {
		.product-follow {
			display: none;
		}
	}

	/* On hover devices the floating screenshot is enough. */
	@media (hover: hover) {
		.touch-image {
			display: none;
		}

		.product-row:hover .product-thumb {
			opacity: 1;
		}

		.product-list:has(.product-row:hover) .product-row {
			opacity: 0.35;
		}

		.product-list:has(.product-row:hover) .product-row:hover {
			opacity: 1;
		}
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.product-row {
			transition:
				opacity 150ms ease-out,
				filter 150ms ease-out;
		}

		.product-list:has(.product-row:hover) .product-row:not(:hover) {
			filter: blur(3px);
		}

		.product-thumb {
			filter: blur(8px);
			transition:
				opacity 350ms ease-out,
				transform 350ms ease-out,
				filter 350ms ease-out;
		}

		.product-row:hover .product-thumb {
			transform: scale(1);
			filter: blur(0);
			transition:
				opacity 250ms cubic-bezier(0.2, 0.7, 0.2, 1),
				transform 250ms cubic-bezier(0.2, 0.7, 0.2, 1),
				filter 250ms cubic-bezier(0.2, 0.7, 0.2, 1);
		}
	}
</style>
