---
import ThemeSwitcher from './ThemeSwitcher.astro';
import SocialLinks from './SocialLinks.astro';

const currentPath = Astro.url.pathname;

// Only the home page has no other h1, so the name is the h1 there.
const NameTag = currentPath === '/' ? 'h1' : 'p';

const links = [
	{ label: 'Home', href: '/' },
	{ label: 'Blog', href: '/blog' },
	{ label: 'Projects', href: '/projects' },
	{ label: 'Work', href: '/work' },
	{ label: 'Favourites', href: '/favourites' },
	{ label: 'Resume', href: '/resume.pdf' },
];

function isActive(href: string) {
	if (href === '/') return currentPath === '/';
	return currentPath.startsWith(href);
}
---

<header>
	<div class="flex flex-wrap items-center gap-4 px-6 py-6">
		<a href="/" class="group flex items-center gap-4">
			<img
				src="/pfp.jpeg"
				alt="Mohak Gupta"
				class="size-12 rounded-lg object-cover motion-safe:transition-transform motion-safe:duration-200 group-hover:-rotate-6"
			/>
			<NameTag class="font-heading text-2xl font-normal">
				Mohak Gupta <span class="text-foreground/60">aka</span> <span class="italic">rushbeef04</span>
			</NameTag>
		</a>
		<div class="ml-auto">
			<SocialLinks />
		</div>
	</div>

	<nav class="flex items-center justify-between border-t border-dotted border-foreground/40 px-6 py-3">
		<ul class="flex flex-wrap gap-x-6 gap-y-1">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class:list={[
								'font-heading text-xl underline-offset-4 hover:text-foreground hover:underline hover:decoration-dotted',
								isActive(link.href)
									? 'text-foreground underline decoration-dotted'
									: 'text-foreground/60',
							]}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
		<ThemeSwitcher />
	</nav>
</header>
