---
// Favourite rows. Hover: other rows blur and a thumbnail follows the cursor.
import type { Favourite } from '../data/favourites';
import { categories, platforms } from '../data/favourites';

interface Props {
	items: Favourite[];
}

const { items } = Astro.props;

// The data stores the category label, the filter uses its slug.
const rows = items.map((item) => {
	const category = categories.find((entry) => entry.label === item.category);
	const platform = platforms[item.platform];

	return {
		name: item.name,
		description: item.description,
		thumbnail: item.thumbnail,
		platform: item.platform,
		slug: category ? category.slug : '',
		platformLabel: platform ? platform.label : item.platform,
		link: platform ? platform.link.replace('{q}', encodeURIComponent(item.name)) : '#',
		search: (item.name + ' ' + item.description + ' ' + item.category).toLowerCase(),
	};
});
---

<div class="favourite-list relative">
	{
		rows.map((row) => (
			<a
				href={row.link}
				target="_blank"
				rel="noopener noreferrer"
				class="favourite-row group flex items-center gap-3 py-2 text-sm"
				data-category={row.slug}
				data-search={row.search}
			>
				<img
					src={`/icons/platforms/${row.platform}.png`}
					alt=""
					class="size-4 shrink-0 rounded-sm"
					width="16"
					height="16"
					title={row.platformLabel}
				/>
				<span class="min-w-0 flex-1 truncate">
					<span class="font-semibold group-hover:dotted">{row.name}</span>
					<span class="mx-2 text-foreground/40">/</span>
					<span class="text-foreground/60">{row.description}</span>
				</span>
				<span class="hidden shrink-0 text-xs text-foreground/60 sm:block">{row.platformLabel}</span>
				{row.thumbnail && (
					<span class="favourite-follow pointer-events-none absolute left-0 top-0 z-10">
						<img
							src={row.thumbnail}
							alt=""
							loading="lazy"
							decoding="async"
							class="favourite-thumb aspect-[2/3] w-40 -translate-x-1/2 rounded-md border border-foreground/40 object-cover"
						/>
					</span>
				)}
			</a>
		))
	}
</div>

<p id="empty" class="hidden py-4 text-sm text-foreground/60">Nothing found.</p>

<script>
	// The thumbnail glides toward the cursor. Position is saved on the list as --x and --y.
	function setupList(list: HTMLElement) {
		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let isRunning = false;

		function move() {
			currentX = currentX + (targetX - currentX) * 0.15;
			currentY = currentY + (targetY - currentY) * 0.15;
			list.style.setProperty('--x', currentX + 'px');
			list.style.setProperty('--y', currentY + 'px');

			const isFarAway = Math.abs(targetX - currentX) > 0.5 || Math.abs(targetY - currentY) > 0.5;
			if (isFarAway) {
				requestAnimationFrame(move);
			} else {
				isRunning = false;
			}
		}

		list.addEventListener('mouseenter', (event) => {
			const box = list.getBoundingClientRect();
			currentX = event.clientX - box.left;
			currentY = event.clientY - box.top;
		});

		list.addEventListener('mousemove', (event) => {
			const box = list.getBoundingClientRect();
			const firstThumb = list.querySelector<HTMLElement>('.favourite-thumb');
			const thumbHeight = firstThumb ? firstThumb.offsetHeight : 240;
			const gap = 24;

			let offsetY = gap;
			if (event.clientY + gap + thumbHeight > window.innerHeight) {
				offsetY = -(gap + thumbHeight);
			}

			targetX = event.clientX - box.left;
			targetY = event.clientY - box.top + offsetY;
			if (!isRunning) {
				isRunning = true;
				requestAnimationFrame(move);
			}
		});
	}

	if (window.matchMedia('(hover: hover)').matches) {
		for (const list of document.querySelectorAll<HTMLElement>('.favourite-list')) {
			setupList(list);
		}
	}
</script>

<style>
	.favourite-follow {
		transform: translate3d(var(--x, 0), var(--y, 0), 0);
	}

	.favourite-thumb {
		opacity: 0;
		transform: scale(0.95);
		transition: opacity 150ms ease-out;
	}

	/* A filtered-out row must not show, even though the row is a flex box. */
	.favourite-row[hidden] {
		display: none;
	}

	@media (hover: none) {
		.favourite-follow {
			display: none;
		}
	}

	@media (hover: hover) {
		.favourite-row:hover .favourite-thumb {
			opacity: 1;
		}

		.favourite-list:has(.favourite-row:hover) .favourite-row {
			opacity: 0.35;
		}

		.favourite-list:has(.favourite-row:hover) .favourite-row:hover {
			opacity: 1;
		}
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.favourite-row {
			transition:
				opacity 150ms ease-out,
				filter 150ms ease-out;
		}

		.favourite-list:has(.favourite-row:hover) .favourite-row:not(:hover) {
			filter: blur(3px);
		}

		.favourite-thumb {
			filter: blur(8px);
			transition:
				opacity 350ms ease-out,
				transform 350ms ease-out,
				filter 350ms ease-out;
		}

		.favourite-row:hover .favourite-thumb {
			transform: scale(1);
			filter: blur(0);
			transition:
				opacity 250ms cubic-bezier(0.2, 0.7, 0.2, 1),
				transform 250ms cubic-bezier(0.2, 0.7, 0.2, 1),
				filter 250ms cubic-bezier(0.2, 0.7, 0.2, 1);
		}
	}
</style>
