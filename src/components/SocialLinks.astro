---
import { FiDownload, FiGithub, FiLinkedin, FiMail } from 'react-icons/fi';

const links = [
	{
		label: 'GitHub',
		href: 'https://github.com/MohakGupta2004',
		external: true,
		Icon: FiGithub,
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/mohak-gupta-007065294',
		external: true,
		Icon: FiLinkedin,
	},
	{
		label: 'Email',
		href: 'mailto:mohakgupta500@gmail.com',
		external: false,
		Icon: FiMail,
	},
	{
		label: 'Download resume',
		href: '/resume.pdf',
		external: false,
		download: true,
		Icon: FiDownload,
	},
];
---

<ul class="flex items-center gap-3">
	{
		links.map((link) => (
			<li>
				<a
					href={link.href}
					aria-label={link.label}
					title={link.label}
					target={link.external ? '_blank' : undefined}
					rel={link.external ? 'noopener noreferrer' : undefined}
					download={link.download ? 'Mohak_Gupta_Resume.pdf' : undefined}
					class="icon-link text-foreground/60 hover:text-foreground"
				>
					<link.Icon class="size-5" />
				</a>
			</li>
		))
	}
</ul>
