<button
	id="theme-switcher"
	type="button"
	aria-label="Switch between dark and light mode"
	class="cursor-pointer text-foreground/60 hover:text-foreground"
>
	<!-- Sun is shown in dark mode (click for light). Moon is shown in light mode. -->
	<svg class="theme-sun size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
	</svg>
	<svg class="theme-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
	</svg>
</button>

<style>
	:global(:root[data-theme='light']) .theme-sun {
		display: none;
	}
	:global(:root:not([data-theme='light'])) .theme-moon {
		display: none;
	}
</style>

<script>
	const button = document.getElementById('theme-switcher');

	function toggleTheme() {
		const root = document.documentElement;
		const isLight = root.dataset.theme === 'light';
		const newTheme = isLight ? 'dark' : 'light';

		root.dataset.theme = newTheme;
		try {
			localStorage.setItem('theme', newTheme);
		} catch (error) {}
	}

	button?.addEventListener('click', toggleTheme);
</script>
