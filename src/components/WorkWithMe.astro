---
import { FiPhoneCall, FiUsers } from 'react-icons/fi';

// Copied from the old portfolio: cal.com call and email for hiring.
const offers = [
	{
		title: 'Consultation',
		about: 'Book a free call to discuss your project.',
		href: 'https://cal.com/MohakGupta2004',
		Icon: FiPhoneCall,
	},
	{
		title: 'Hire me',
		about: 'Have freelance work or a job opening? Email me.',
		href: 'mailto:mohakgupta500@gmail.com',
		Icon: FiUsers,
	},
];
---

<section class="border-t border-dotted border-foreground/40 px-6 py-8">
	<h2 class="marker font-heading text-4xl">Work with me</h2>

	<div class="mt-4 space-y-3">
		{
			offers.map((offer) => (
				<a href={offer.href} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 text-sm">
					<offer.Icon class="size-5 shrink-0 text-foreground/60" />
					<span class="min-w-0 truncate">
						<span class="font-semibold group-hover:dotted">{offer.title}</span>
						<span class="text-foreground/60"> · {offer.about}</span>
					</span>
				</a>
			))
		}
	</div>
</section>
