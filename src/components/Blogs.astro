---
import BlogList from './BlogList.astro';
import { getBlogs } from '../data/blogs';

// Only the 3 newest blogs on the landing page.
const blogs = await getBlogs();
const newestBlogs = blogs.slice(0, 3);
---

<section class="border-t border-dotted border-foreground/40 px-6 py-8">
	<h2 class="font-heading text-2xl">Blogs</h2>

	<div class="mt-4">
		<BlogList blogs={newestBlogs} />
	</div>

	<a href="/blog" class="dotted mt-6 inline-block text-sm text-foreground/60 hover:text-foreground">view all blogs →</a>
</section>
