---
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import BlogList from '../../components/BlogList.astro';
import { getBlogs } from '../../data/blogs';

const blogs = await getBlogs();
---

<Layout
	title="Blog | Mohak Gupta"
	description="Posts by Mohak Gupta on backend engineering, system design, microservices, Rust and programming."
>
	<main class="mx-auto flex overflow-y-clip min-h-screen max-w-2xl flex-col border-x border-dashed border-foreground/40">
		<Header />

		<section class="px-6 py-8">
			<h1 class="font-heading text-5xl font-bold">Blog</h1>
			<p class="mt-2 text-sm text-foreground/60">Thoughts, tutorials, and insights on engineering and programming.</p>

			<div class="mt-8">
				<BlogList blogs={blogs} large />
			</div>
		</section>

		<div class="mt-auto">
			<Footer />
		</div>
	</main>
</Layout>
