---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import PostToc from '../../components/PostToc.astro';

// Every blog post comes from the collection in src/content/blog.
export async function getStaticPaths() {
	const posts = await getCollection('blog');

	const postPaths = posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));

	return postPaths;
}

interface Props {
	entry?: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
const headings = rendered?.headings ?? [];

const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

// Turns a date into 19.APR.2026.
function formatDate(date: Date) {
	const months = [
		'JAN',
		'FEB',
		'MAR',
		'APR',
		'MAY',
		'JUN',
		'JUL',
		'AUG',
		'SEP',
		'OCT',
		'NOV',
		'DEC',
	];

	const day = String(date.getUTCDate()).padStart(2, '0');
	const month = months[date.getUTCMonth()];
	const year = date.getUTCFullYear();

	return `${day}.${month}.${year}`;
}
---

{
	entry ? (
		<Layout
			title={`${entry.data.title} | Mohak Gupta`}
			description={entry.data.description}
			image={entry.data.thumbnail}
			type="article"
			publishedTime={entry.data.date}
		>
			<main class="mx-auto flex min-h-screen max-w-2xl flex-col overflow-y-clip border-x border-dashed border-foreground/40">

				<article class="px-6 py-8 pb-32">
					<div class="flex items-center gap-2 text-sm">
						<img src="/pfp.jpeg" alt="Mohak Gupta" class="size-6 shrink-0 rounded-full object-cover" />
						<span class="shrink-0">Mohak Gupta</span>
						<span class="shrink-0 text-foreground/60">/</span>
						<a href="/blog" class="shrink-0 hover:dotted">
							Writing
						</a>
						<span class="shrink-0 text-foreground/60">/</span>
						<span class="min-w-0 truncate text-foreground/60">{entry.data.title}</span>
					</div>

					<h1 class="mt-10 font-heading text-5xl font-bold">{entry.data.title}</h1>
					<p class="mt-2 font-mono text-xs text-foreground/60">{formatDate(entry.data.date)}</p>

					<div class="post-body mt-8">
						<Content />
					</div>
				</article>

				<div class="mt-auto">
					<Footer />
				</div>

				{tocHeadings.length >= 2 && <PostToc headings={tocHeadings} />}
			</main>
		</Layout>
	) : (
		<Layout />
	)
}

<style is:global>
	/* Paragraphs */
	.post-body p {
		margin-top: 1rem;
		font-size: 0.875rem;
		line-height: 1.625;
		text-align: justify;
	}

	/* Drop cap on the first paragraph */
	.post-body > p:first-of-type::first-letter {
		float: left;
		font-family: var(--font-heading);
		font-size: 3.5rem;
		line-height: 0.85;
		padding-right: 0.5rem;
	}

	/* Headings */
	.post-body h2 {
		margin-top: 3rem;
		font-family: var(--font-heading);
		font-size: 1.875rem;
		line-height: 2.25rem;
		font-weight: 700;
		scroll-margin-top: 2rem;
	}

	.post-body h3 {
		margin-top: 2rem;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		line-height: 2rem;
		font-weight: 400;
		scroll-margin-top: 2rem;
	}

	/* Links */
	.post-body a {
		text-decoration-line: underline;
		text-decoration-style: dotted;
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	/* Lists */
	.post-body ul {
		margin-top: 0.75rem;
		padding-left: 1.5rem;
		font-size: 0.875rem;
		list-style-type: disc;
	}

	.post-body ol {
		margin-top: 0.75rem;
		padding-left: 1.5rem;
		font-size: 0.875rem;
		list-style-type: decimal;
	}

	.post-body li {
		margin-top: 0.25rem;
	}

	/* Inline code */
	.post-body code {
		border-radius: 0.25rem;
		background-color: color-mix(in srgb, var(--color-foreground) 10%, transparent);
		padding: 0.125rem 0.375rem;
		font-size: 0.85em;
	}

	/* Code blocks */
	.post-body pre {
		margin-top: 1rem;
		padding: 1rem;
		border-radius: 0.5rem;
		overflow-x: auto;
		font-size: 0.75rem;
		line-height: 1rem;
		text-align: left;
		background-color: color-mix(in srgb, var(--color-foreground) 10%, transparent) !important;
	}

	.post-body pre code {
		padding: 0;
		border-radius: 0;
		background: none;
		font-size: inherit;
	}

	/* Images */
	.post-body img {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 1.5rem auto 0;
		border: 1px solid color-mix(in srgb, var(--color-foreground) 20%, transparent);
		border-radius: 0.5rem;
	}

	/* Tables */
	.post-body table {
		width: 100%;
		margin-top: 1rem;
		font-size: 0.875rem;
		border-collapse: collapse;
	}

	.post-body th,
	.post-body td {
		border: 1px solid color-mix(in srgb, var(--color-foreground) 20%, transparent);
		padding: 0.5rem 0.75rem;
	}

	.post-body th {
		text-align: left;
	}

	/* Quotes */
	.post-body blockquote {
		margin-top: 1rem;
		padding-left: 1rem;
		border-left: 2px solid color-mix(in srgb, var(--color-foreground) 40%, transparent);
		color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
		font-style: italic;
	}
</style>
